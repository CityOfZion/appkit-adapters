{
  "name": "@cityofzion/appkit-bitcoin-adapter",
  "version": "1.0.0",
  "description": "AppKit adapter for Bitcoin blockchain",
  "author": "João Paulo Hotequil (https://github.com/hotequil)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CityOfZion/appkit-adapters.git"
  },
  "license": "Apache-2.0",
  "keywords": [
    "appkit",
    "wallet",
    "dapps",
    "web3",
    "bitcoin",
    "blockchain",
    "adapter"
  ],
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/CityOfZion/appkit-adapters/issues"
  },
  "homepage": "https://github.com/CityOfZion/appkit-adapters/tree/main/packages/appkit-bitcoin-adapter#readme",
  "scripts": {
    "build": "rm -rf ./dist && npm run typecheck && tsc --project tsconfig.json",
    "format": "eslint --fix",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2"
  },
  "peerDependencies": {
    "@reown/appkit": "*",
    "@reown/appkit-common": "*",
    "@reown/appkit-controllers": "*",
    "@walletconnect/universal-provider": "*"
  }
}
